# Desenvolvimento local
NODE_ENV=development
CACHE_DRIVER=memory

# TSE
TSE_ENV=mock
TSE_BASE_URL=https://resultados.tse.jus.br
TSE_RESULTS_ENV=oficial
TSE_UF=PR
TSE_ROUND=1
TSE_PLEITO_ID=
TSE_FETCH_TIMEOUT_MS=5000
TSE_MAX_PAYLOAD_BYTES=5242880
TSE_JWS_MODE=required
# Orçamento de tempo (ms) por cargo para coletar os municípios a cada execução; 0 desliga
TSE_MUNICIPAL_BUDGET_MS=20000
COLLECTOR_SECRET=

# Upstash - preencher apenas quando CACHE_DRIVER=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live — somente YouTube: watch, youtu.be, /live/, /embed/ ou embed/live_stream?channel=UC...
LIVE_PROVIDER=youtube
LIVE_EMBED_URL=

# Site
NEXT_PUBLIC_SITE_NAME=PR+ Eleições 2026
NEXT_PUBLIC_SITE_URL=http://localhost:3000
