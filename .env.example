# Desenvolvimento local
NODE_ENV=development
CACHE_DRIVER=memory

# TSE
TSE_ENV=mock
TSE_BASE_URL=https://resultados.tse.jus.br
TSE_RESULTS_ENV=oficial
TSE_UF=PR
TSE_ROUND=1
TSE_PLEITO_ID=
TSE_FETCH_TIMEOUT_MS=5000
TSE_MAX_PAYLOAD_BYTES=5242880
TSE_JWS_MODE=required
COLLECTOR_SECRET=

# Upstash - preencher apenas quando CACHE_DRIVER=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live
LIVE_PROVIDER=instagram
LIVE_EMBED_URL=

# Site
NEXT_PUBLIC_SITE_NAME=PR+ Eleições 2026
NEXT_PUBLIC_SITE_URL=http://localhost:3000
